# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
# Ignore the folder where all third-party libraries are installed.
# This can be regenerated by running `npm install` or `yarn`.
/node_modules
/.pnp
.pnp.js

# Build & Production
# Ignore the folder that contains the final, bundled code for production.
# This is typically 'dist' for Vite or 'build' for Create React App.
/dist
/build

# Logs
# Ignore log files generated by npm or yarn.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
# Ignore all local environment files. These often contain sensitive API keys.
# You should commit a template file instead (e.g., .env.example).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# IDE & Editor directories
# Ignore configuration folders for popular code editors.
.vscode/
.idea/

# OS-generated files
# Ignore system files that can appear on different operating systems.
.DS_Store
Thumbs.db

# Test & Coverage
# Ignore the output of your test coverage reports.
/coverage
.nyc_output

# Caching
# Ignore cache directories from various tools.
.npm
.eslintcache
.cache
.babel-cache
